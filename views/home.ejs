    <script>

        window.addEventListener('load', function() {
            // GSAP to animate truck moving right across the screen
            gsap.to("#truck", {
                x: "100vw",
                duration: 5, // Adjust this to change how fast the truck moves
                ease: "linear", // Smooth linear movement
                onComplete: function() {
                    // Once the animation is complete, hide the loader and show the content
                    document.getElementById('loader').style.display = 'none';
                    // Show main content by removing opacity
                    gsap.to("#main", {
                        opacity: 1,
                        duration: 1
                    });
                }
            });
        });
        document.addEventListener("DOMContentLoaded", function () {
    gsap.timeline()
        .to("#truck", { x: "100vw", duration: 3, ease: "power2.out" }) // Truck moves
        .to("#loader-text", { opacity: 1, duration: 0.5, ease: "power2.inOut" }, "-=2.5") // Show full text
        .from(".your", { opacity: 0, x: -50, duration: 0.5, ease: "back.out(1.7)" }, "-=2") // Stagger text
        .from(".experience", { opacity: 0, x: -50, duration: 0.5, ease: "back.out(1.7)" }, "-=1.8")
        .from(".is-loading", { opacity: 0, scale: 1.2, duration: 0.6, ease: "power1.inOut", repeat: -1, yoyo: true }, "-=1.6");
});
     gsap.from("#logo", { opacity: 0, scale: 0.5, duration: 1 });
  // Selecting elements
document.addEventListener('DOMContentLoaded', () => {
    // GSAP Scroll Animation for Images
    gsap.from('.u-image', {
      opacity: 0,
      x: -100, // Move images from left
      duration: 1.5,
      stagger: 0.3,
      ease: 'power4.out',
    });
  
    // GSAP Scroll Animation for Headings (With Scribble Effect)
    gsap.from('.scribble-heading', {
      opacity: 0,
      y: -50,
      duration: 1.5,
      stagger: 0.3,
      ease: 'power4.out',
    });
  
    // GSAP Scroll Animation for Paragraph Text
    gsap.from('.u-text', {
      opacity: 0,
      y: 50,
      duration: 1.5,
      stagger: 0.3,
      ease: 'power4.out',
    });
  });
  
  gsap.from(".service-box", {
                opacity: 0,
                y: 50,
                duration: 1,
                stagger: 0.3
            });
    
            gsap.from("h2 span", {
                opacity: 0,
                x: -20,
                duration: 1.2
            });

    </script>
 
