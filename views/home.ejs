    <style>/* Amoeba effect animation */

.loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color:#FFF5E1;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }
        .truck {
            width: 200px;
            height: auto;
            position: absolute;
            left: -300px;
            transform: translateY(-50%);
        }
        .truck {
            position: absolute;
            left: 0;
            width: 100px;
        }
        @keyframes amoebaAnimation {
           0% {
              transform: scale(1);
              border-radius: 50%;
              background-color: #d3d3d3;
           }
           25% {
              transform: scale(1.1);
              border-radius: 60%;
              background-color: #c8c8c8;
           }
           50% {
              transform: scale(1.2);
              border-radius: 70%;
              background-color: #b2b2b2;
           }
           75% {
              transform: scale(1.1);
              border-radius: 60%;
              background-color: #c8c8c8;
           }
           100% {
              transform: scale(1);
              border-radius: 50%;
              background-color: #d3d3d3;
           }
        }
        
        /* Apply the animation */
        .amoeba-effect {
           animation: amoebaAnimation 4s infinite ease-in-out;
           display: inline-flex;
           align-items: center;
           justify-content: center;
           padding: 10px 20px;
           font-size: 16px;
           text-align: center;
           border: 2px solid #fa472d;
           position: relative;
           transition: background-color 0.3s ease, transform 0.3s ease, border-radius 0.3s ease;
        }
 /* Styling for the images */
.u-image {
    max-width: 350px; /* Image size increased slightly */
    width: auto;
    height: auto;
    transition: transform 0.5s ease; /* Smooth transition for scaling */
}

/* Added padding for the text sections */
.pl-8 {
    padding-left: 2rem;
}

/* Added margin-top between sections */
.mt-8 {
    margin-top: 2rem;
}

/* For Scribble Effect (Applied to All Headings) */
.scribble-heading {
    position: relative;
    display: inline-block;
    font-size: 2rem;
    font-weight: bold;
}

.scribble-heading::before {
    content: "";
    position: absolute;
    top: -10px;
    left: -10px;
    width: 100%;
    height: 5px;
    background: #FF6347; /* Red Scribble Color */
    transform: rotate(-5deg);
    animation: scribble 1.5s infinite ease-in-out;
}

.scribble-heading::after {
    content: "";
    position: absolute;
    top: 10px;
    left: -10px;
    width: 100%;
    height: 5px;
    background: #FF6347; /* Red Scribble Color */
    transform: rotate(5deg);
    animation: scribble 1.5s infinite ease-in-out reverse;
}

/* Scribble Animation */
@keyframes scribble {
    0% { transform: translateX(0) rotate(0); }
    50% { transform: translateX(5px) rotate(-10deg); }
    100% { transform: translateX(0) rotate(0); }
}

/* Flex layout for responsiveness */
.flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.u-clearfix {
    clear: both;
}

.u-sheet {
    padding: 2rem;
}

/* Optional: Adjust layout for mobile responsiveness */
@media (max-width: 768px) {
    .flex {
        flex-direction: column;
        align-items: center;
    }
    
    .pl-8 {
        padding-left: 0;
    }
    
    .u-image {
        max-width: 250px;
    }
}
.o_text_highlight_fill {
            --text-highlight-color: #fa472d;
            --text-highlight-width: 0px !important;
        }


        </style>
