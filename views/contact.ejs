    <style>
  /* Scribble effect on text */
  .scribble {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .scribble::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: transparent;
            border-top: 2px solid #EC2507;
            border-left: 2px solid #EC2507;
            transform: scaleX(0) scaleY(0);
            transform-origin: top left;
            transition: all 0.3s ease;
        }

        .scribble:hover::after {
            transform: scaleX(1) scaleY(1);
        }

        /* Parallax effect */
        .parallax {
            background-attachment: fixed;
            background-size: cover;
            background-position: center;
        }

        /* Custom background shapes */
        .shape {
            position: absolute;
            background-color: rgba(236, 37, 7, 0.5);
            width: 80px;
            height: 80px;
            border-radius: 50%;
            opacity: 0.5;
        }

        .shape-two {
            background-color: rgb(230, 47, 18);
        }

        .shape-three {
            background-color: rgba(255, 255, 255, 0.5);
        }
    </style>
