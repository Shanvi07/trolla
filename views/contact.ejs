    <!-- GSAP Animation Script -->
    <script>
      // GSAP animations
       // GSAP animations
       gsap.from(".scribble", {
            opacity: 0,
            y: -50,
            duration: 1,
            ease: "power2.out"
        });

        gsap.from(".card", {
            opacity: 0,
            y: 50,
            stagger: 0.3,
            duration: 1,
            ease: "power2.out"
        });

        gsap.from(".lead", {
            opacity: 0,
            x: -100,
            duration: 1,
            delay: 0.5,
            ease: "power2.out"
        });

        // Animation for moving shapes
        gsap.to(".shape-one", {
            x: "100vw",
            rotation: 360,
            duration: 10,
            repeat: -1,
            ease: "linear"
        });

        gsap.to(".shape-two", {
            y: "100vh",
            rotation: -360,
            duration: 12,
            repeat: -1,
            ease: "linear"
        });

        gsap.to(".shape-three", {
            x: "-100vw",
            y: "-100vh",
            rotation: 720,
            duration: 15,
            repeat: -1,
            ease: "linear"
